---
interface Props {
  className?: string;
}

const { className = "h-15 w-auto" } = Astro.props;
---

<a href="/" class="flex items-center gap-2 group focus:outline-none">
  <!-- Book + Pencil Logo Icon -->
  <img
    src="/assets/logo.png"
    alt="For Keeps Logo"
    class={`object-contain bg-transparent ${className}`}
  />

  <!-- Typography matching the uploaded asset -->
  <span
    class="font-brand text-3xl tracking-normal text-[#117a75] dark:text-[#2dd4bf] font-bold antialiased pt-0.5"
  >
  For Keeps
  </span>
</a>
