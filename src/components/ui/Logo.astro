---
interface Props {
  className?: string;
}

const { className = "h-15 w-auto" } = Astro.props;
---

<a href="/" class="flex items-center gap-2 group focus:outline-none">
  <img
    src="/assets/brand/book-mark-128.png"
    alt="For Keeps book mark"
    class={`object-contain bg-transparent ${className}`}
  />

  <span class="font-brand text-2xl tracking-normal text-[#04a7a4] font-normal antialiased pt-0.45">
    For Keeps
  </span>
</a>
