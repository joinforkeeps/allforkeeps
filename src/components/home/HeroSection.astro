---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import {
  primaryCta,
  primaryCtaLabel,
  secondaryCtaLabel,
  serviceLinks,
} from "@/config/site.js";
const primaryUrl = serviceLinks[primaryCta];
const secondaryUrl =
  primaryCta === "assessment"
    ? serviceLinks.newsletter
    : serviceLinks.assessment;
const stats = [
  {
    label: "Course progress",
    values: ["25%", "50%", "75%", "100%"],
    note: "Demo progress",
  },
  {
    label: "Quests completed",
    values: ["1 / 4", "2 / 4", "3 / 4", "4 / 4"],
    note: "Example path",
  },
  {
    label: "Practice tasks",
    values: ["1 / 4", "2 / 4", "3 / 4", "4 / 4"],
    note: "Sample tasks",
  },
  {
    label: "Savings",
    values: ["$580.75"],
    note: "Fees saved",
  },
];
---

<section class="fk-hero site-container" aria-label="For Keeps introduction">
  <div class="fk-hero-grid">
    <div class="fk-hero-copy">
      <div class="fk-badges">
        <Badge variant="accent">Learn it</Badge>
        <Badge variant="primary">Built for nonprofits</Badge>
        <Button url="/start" type="fill" size="sm" className="fk-open-button">
          Open to all
        </Button>
      </div>
      <h1>
        <AnimatedText
          content="Own Your Tools."
          delay={0.1}
          duration={0.5}
          stagger={0.08}
          class="block text-4xl lg:text-6xl font-brand text-neutral-900 dark:text-white leading-tight"
        />
        <AnimatedText
          content="For Keeps"
          delay={0.25}
          duration={0.5}
          stagger={0.08}
          class="block text-4xl lg:text-6xl font-brand text-primary leading-tight"
        />
      </h1>
      <p class="fk-intro">
        Before you pay for Salesforce, GoFundMe, Perplexity, or DonorSearch,
        know your options.
      </p>
      <p class="fk-intro text-primary">
        We help nonprofit teams find tools and learn what it takes to run them.
        Everyone is welcome; paid work helps us build practical options for
        smaller organisations.
      </p>
      <div class="fk-actions">
        <Button url={primaryUrl} event="heroPrimaryCta">
          {primaryCtaLabel}
        </Button>
        <Button url={secondaryUrl} event="heroSecondaryCta">
          {secondaryCtaLabel}
        </Button>
        <Button url={serviceLinks.learning} event="browseCourses">
          Browse Courses
        </Button>
      </div>
      <p class="fk-course-status">
        The free introduction and Twenty CRM course are planned for December 1.
        Paid registration is not open yet.
      </p>
    </div>
    <div class="fk-preview">
      <BrowserFrame url="learn.allforkeeps.com" className="w-full">
        <div class="fk-tracker" data-fk-tracker>
          <div class="fk-tracker-heading">
            <span class="fk-tracker-title">
              <span class="fk-orbit-dot" aria-hidden="true"></span>Mission Log
            </span>
            <span class="fk-demo-label">Demo</span>
          </div>
          <div class="fk-stats">
            {stats.map((stat) => (
              <div
                class:list={[
                  "fk-stat",
                  stat.label === "Savings" && "fk-stat-savings",
                ]}
              >
                <>
                  <span class="fk-stat-label">{stat.label}</span>
                  <span
                    class="fk-stat-value"
                    data-values={JSON.stringify(stat.values)}
                  >
                    {stat.values[0]}
                  </span>
                  <span class="fk-stat-note">{stat.note}</span>
                  {stat.label === "Savings" && (
                    <div class="fk-savings-chart">
                      <svg
                        viewBox="0 0 120 42"
                        role="img"
                        aria-label="Illustrative savings rising over four periods"
                        preserveAspectRatio="none"
                      >
                        <path
                          class="fk-savings-grid"
                          d="M1 34H119 M1 21H119 M1 8H119"
                        />
                        <path
                          class="fk-savings-line"
                          d="M2 36 C18 34 22 29 34 30 S52 22 64 24 S83 14 95 17 S108 7 118 5"
                        />
                      </svg>
                      <div class="fk-savings-periods" aria-hidden="true">
                        <span>Start</span>
                        <span>Later</span>
                      </div>
                    </div>
                  )}
                  {stat.label === "Course progress" && (
                    <div
                      class="fk-course-progress"
                      aria-label="Illustrative course progress: 25 percent"
                    >
                      <span class="fk-course-progress-fill"></span>
                      <span class="fk-course-progress-flag" aria-hidden="true">
                        ⚑
                      </span>
                    </div>
                  )}
                </>
              </div>
            ))}
          </div>
          <div class="fk-chart">
            <div class="fk-chart-heading">
              <span>Learning activity</span>
              <span>7 days</span>
            </div>
            <div class="fk-bars" aria-hidden="true">
              {[24, 28, 34, 38, 44, 52, 58].map((height) => (
                <span class="fk-bar" style={`height:${height}%`} />
              ))}
            </div>
          </div>
        </div>
      </BrowserFrame>
      <p class="fk-caption">
        Sample dashboard. Hosting and hardware can add costs; you may already
        have what you need.
      </p>
      <button
        class="fk-motion-button"
        type="button"
        data-fk-motion
        data-umami-event="previewMotionToggle"
        aria-pressed="false"
      >
        Stop preview
      </button>
    </div>
  </div>
</section>
<style>
  .fk-hero {
    padding-top: clamp(1rem, 2.5vw, 2.25rem);
    padding-bottom: 1rem;
  }
  .fk-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
  }
  .fk-hero-copy,
  .fk-preview {
    min-width: 0;
    width: 100%;
  }
  .fk-preview {
    max-width: 42rem;
    justify-self: center;
  }
  .fk-badges,
  .fk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .fk-badges {
    margin-bottom: 1.25rem;
  }
  .fk-actions {
    margin-top: 0.75rem;
  }
  .fk-open-button {
    text-align: center;
  }
  .fk-course-status {
    margin-top: 0.75rem;
    color: var(--color-text-tertiary);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  h1 {
    margin: 0 0 0.75rem;
  }
  .fk-intro {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0.4rem 0;
  }
  .fk-tracker {
    box-sizing: border-box;
    width: 100%;
    padding: clamp(0.8rem, 2vw, 1.5rem);
    display: grid;
    gap: 1rem;
    color: #e8fffc;
    background:
      linear-gradient(rgba(143, 255, 244, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(143, 255, 244, 0.045) 1px, transparent 1px),
      radial-gradient(
        ellipse at 82% 0%,
        rgba(4, 167, 164, 0.32),
        transparent 58%
      ),
      radial-gradient(
        ellipse at 16% 100%,
        color-mix(in srgb, var(--color-logo-green) 20%, transparent),
        transparent 46%
      ),
      linear-gradient(135deg, #0d4847 0%, #073a3a 48%, #062c32 100%);
    background-size:
      28px 28px,
      28px 28px,
      auto,
      auto,
      auto;
    border: 1px solid rgba(115, 230, 219, 0.4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  .fk-tracker-heading,
  .fk-chart-heading {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
  }
  .fk-tracker-title {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .fk-demo-label {
    font-size: 0.7rem;
    border: 1px solid rgba(115, 230, 219, 0.5);
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
  }
  .fk-orbit-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: #d4773b;
    border-radius: 50%;
    box-shadow: 0 0 0 0 #d4773b66;
    animation: fk-ping 2s infinite;
    flex-shrink: 0;
  }
  .fk-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .fk-stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.65rem;
    border: 1px solid rgba(115, 230, 219, 0.24);
    border-radius: 0.65rem;
    background: linear-gradient(
      145deg,
      rgba(12, 82, 79, 0.72),
      rgba(5, 39, 43, 0.9)
    );
  }
  .fk-stat-label {
    font-size: 0.7rem;
    line-height: 1.5;
    color: #b7ddd9;
    overflow-wrap: anywhere;
  }
  .fk-stat-value {
    font-size: clamp(1.15rem, 2vw, 1.7rem);
    line-height: 1.2;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: opacity 0.18s;
  }
  .fk-stat-note {
    font-size: 0.65rem;
    line-height: 1.4;
    color: var(--color-dashboard-orange);
    font-variant-numeric: tabular-nums;
  }
  .fk-stat-savings {
    grid-row: span 2;
  }
  .fk-savings-chart {
    display: grid;
    gap: 0.25rem;
    margin-top: auto;
  }
  .fk-savings-chart svg {
    width: 100%;
    height: 2.8rem;
    overflow: visible;
  }
  .fk-savings-grid {
    fill: none;
    stroke: rgba(183, 221, 217, 0.2);
    stroke-width: 0.7;
  }
  .fk-savings-line {
    fill: none;
    stroke: var(--color-dashboard-orange);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .fk-savings-periods {
    display: flex;
    justify-content: space-between;
    color: #b7ddd9;
    font-size: 0.58rem;
  }
  .fk-course-progress {
    position: relative;
    height: 0.6rem;
    margin-top: 0.15rem;
    border-bottom: 2px solid rgba(242, 246, 253, 0.8);
  }
  .fk-course-progress-fill {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 50%;
    height: 2px;
    background: var(--color-dashboard-orange);
  }
  .fk-course-progress-flag {
    position: absolute;
    right: -0.05rem;
    bottom: -0.35rem;
    color: var(--color-dashboard-orange);
    font-size: 0.8rem;
    line-height: 1;
  }
  .fk-chart {
    border: 1px solid rgba(115, 230, 219, 0.24);
    border-radius: 0.65rem;
    padding: 0.65rem;
    background: linear-gradient(
      145deg,
      rgba(4, 167, 164, 0.15),
      rgba(5, 39, 43, 0.52)
    );
  }
  .fk-chart-heading {
    font-size: 0.7rem;
    color: #b7ddd9;
  }
  .fk-bars {
    height: 4rem;
    display: flex;
    gap: 0.45rem;
    align-items: flex-end;
    margin-top: 0.8rem;
  }
  .fk-bar {
    flex: 1;
    min-width: 0;
    border-radius: 0.2rem 0.2rem 0 0;
    background: rgba(4, 167, 164, 0.55);
    transition: height 0.9s ease;
  }
  .fk-bar:last-child {
    background: var(--color-dashboard-orange);
  }
  .fk-caption {
    font-size: 0.72rem;
    line-height: 1.6;
    text-align: center;
    margin: 0.75rem 0 0.3rem;
    color: #b7ddd9;
  }
  .fk-motion-button {
    display: block;
    margin: 0 auto;
    padding: 0.25rem 0.5rem;
    font-size: 0.72rem;
    color: var(--color-dashboard-orange);
    text-decoration: underline;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .fk-motion-button:focus-visible {
    outline: 2px solid var(--color-dashboard-orange);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }
  @media (min-width: 1024px) {
    .fk-hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(1rem, 1.5vw, 1.5rem);
    }
    .fk-preview {
      align-self: center;
    }
  }
  @media (max-width: 359px) {
    .fk-stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @keyframes fk-ping {
    70% {
      box-shadow: 0 0 0 7px #d4773b00;
    }
    100% {
      box-shadow: 0 0 0 0 #d4773b00;
    }
  }
  .fk-paused .fk-orbit-dot {
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .fk-orbit-dot {
      animation: none;
    }
    .fk-bar,
    .fk-stat-value {
      transition: none;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-fk-tracker]")
    .forEach((host) => {
      const preview = host.closest<HTMLElement>(".fk-preview");
      const button =
        preview?.querySelector<HTMLButtonElement>("[data-fk-motion]");
      const preference = window.matchMedia("(prefers-reduced-motion: reduce)");
      const values = host.querySelectorAll<HTMLElement>("[data-values]");
      const bars = host.querySelectorAll<HTMLElement>(".fk-bar");
      const cycles = [
        [24, 28, 34, 38, 44, 52, 58],
        [30, 34, 40, 46, 54, 62, 68],
        [36, 40, 48, 54, 62, 72, 78],
        [42, 48, 56, 64, 72, 82, 90],
      ];
      let tick = 0,
        paused = preference.matches;
      function sync() {
        host.classList.toggle("fk-paused", paused);
        button?.setAttribute("aria-pressed", String(paused));
        if (button)
          button.textContent = paused ? "Resume preview" : "Stop preview";
      }
      button?.addEventListener("click", () => {
        paused = !paused;
        sync();
      });
      preference.addEventListener("change", () => {
        paused = preference.matches;
        sync();
      });
      sync();
      const timer = window.setInterval(() => {
        if (!host.isConnected) {
          window.clearInterval(timer);
          return;
        }
        if (paused || document.hidden) return;
        tick = (tick + 1) % 4;
        values.forEach((el) => {
          const data = JSON.parse(el.dataset.values || "[]") as string[];
          if (data[tick]) el.textContent = data[tick];
        });
        bars.forEach((bar, i) => {
          bar.style.height = `${cycles[tick][i]}%`;
        });
      }, 3200);
    });
</script>
