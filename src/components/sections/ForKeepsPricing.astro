---
const plans=[
 {name:"Free Learning",price:"Free",desc:"Start with the free learning resources we publish.",features:["Public guides and quickstarts","Self-paced learning","Open-source discovery","No paid subscription required to read free resources"],url:"/courses",cta:"Explore quickstarts"},
 {name:"Community",price:"Free to join",desc:"Connect through public channels and learn with others.",features:["Public social channels","Peer discussion where available","Project updates","No guaranteed support response time"],url:"/community",cta:"Find the community"},
 {name:"Custom Builds & Support",price:"Custom quote",desc:"Discuss a scoped project for your organization.",features:["Needs and project-scope discussion","Tool and workflow planning","Handover requirements agreed in advance","Hosting, maintenance, and support priced by scope"],url:"/contact",cta:"Discuss your project"},
];
---
<section class="site-container fk-pricing">
 <header><h2>What’s free. What’s paid. What’s separate.</h2><p>Learn through free resources, connect with the community, or discuss a custom project your organization can control.</p></header>
 <div class="fk-pricing-grid">{plans.map(plan=><article><h3>{plan.name}</h3><p class="fk-price">{plan.price}</p><p>{plan.desc}</p><ul>{plan.features.map(feature=><li>{feature}</li>)}</ul><a href={plan.url}>{plan.cta} →</a></article>)}</div>
 <p class="fk-pricing-footnote">Self-hosting can still involve infrastructure, email delivery, maintenance, and other operating costs. Paid work begins only after the scope and price are agreed.</p>
</section>
<style>
.fk-pricing{padding-top:2rem;padding-bottom:2rem}.fk-pricing header{max-width:45rem;margin-bottom:1.5rem}.fk-pricing h2{font-size:clamp(1.8rem,4vw,2.5rem);line-height:1.2}.fk-pricing p{line-height:1.7;margin:.7rem 0}.fk-pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1rem}.fk-pricing article{display:flex;flex-direction:column;min-width:0;border:1px solid #b7caff77;border-radius:1rem;padding:1.5rem}.fk-pricing h3{font-size:1.2rem;font-weight:600}.fk-price{font-size:1.7rem;color:#2d6dc3}.fk-pricing ul{padding-left:1.2rem;list-style:disc;line-height:1.8;margin:1rem 0 1.5rem}.fk-pricing article a{margin-top:auto;padding:.8rem;border:1px solid #b7caff;border-radius:.6rem;color:#2d6dc3;text-align:center}.fk-pricing-footnote{font-size:.8rem;color:#64748b}:global(html.dark) .fk-price,:global(html.dark) .fk-pricing article a{color:#93c5fd}:global(html.dark) .fk-pricing-footnote{color:#b6c2d4}
</style>
