---
import Button from "@/components/ui/Button.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import { membershipConfig } from "@/config/membership";
import { formatCoursePrice, pricingConfig } from "@/config/pricing";
import { siteConfig } from "@/config/site.js";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = "Build it. Then own it. All for keeps.",
  description = "Free guides available, open mailing list membership, and a one-time fee for each premium course.",
  showHeader = true,
} = Astro.props;
const coursePrice = formatCoursePrice(pricingConfig.coursePriceUsd);
const membershipPrice = formatCoursePrice(membershipConfig.costUsd);
---

<section
  class="site-container py-6 md:py-8"
  aria-label="For Keeps pricing"
  data-feature="three-tier-pricing"
  data-member-copy={pricingConfig.memberCoursePriceCopy}
  data-non-member-copy={pricingConfig.nonMemberCoursePriceCopy}
>
  {showHeader && (
    <div class="mb-5">
      <SectionHeader title={title} description={description} />
    </div>
  )}
  <div class="grid grid-cols-1 items-stretch gap-4 md:grid-cols-3">
    <article class="flex flex-col rounded-2xl border border-primary/15 bg-white/80 p-5 shadow-sm dark:bg-bg-secondary-dark md:p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-primary">
        Open to all
      </p>
      <h3 class="mt-2 text-xl font-semibold text-neutral-900 dark:text-white">
        Starter Pack
      </h3>
      <p class="mt-3 font-brand text-3xl text-primary">Free</p>
      <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
        Learn at your own pace. No account or mailing list signup is required to
        read public guides.
      </p>
      <ul class="my-5 flex-1 space-y-2 text-sm text-neutral-700 dark:text-neutral-200">
        <li>Public quickstarts and field notes</li>
        <li>{pricingConfig.introCourseName}</li>
        <li>One introductory course is free for everyone</li>
      </ul>
      <Button
        url="/courses"
        event="browseCourses"
        className="w-full justify-center"
        type="outline"
      >
        {pricingConfig.callsToAction.free}
      </Button>
    </article>

    <article
      class="relative flex flex-col rounded-2xl border-2 border-rose-700 bg-gradient-to-b from-rose-50/80 via-white/95 to-logo-green/5 p-5 shadow-[0_12px_36px_rgba(127,29,29,0.16)] dark:border-rose-500 dark:from-rose-950/45 dark:via-bg-secondary-dark dark:to-logo-green/10 md:-translate-y-1 md:p-6"
      data-feature="highlighted-member-card"
    >
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-rose-800 px-3 py-1 text-xs font-bold text-white dark:bg-rose-600">
        Best value
      </span>
      <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-rose-800 dark:text-rose-300">
        Free membership
      </p>
      <h3 class="mt-2 text-xl font-semibold text-neutral-900 dark:text-white">
        Join For Keeps
      </h3>
      <p class="mt-3 font-brand text-3xl text-primary">
        {membershipPrice} to join
      </p>
      <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
        {membershipConfig.memberDefinition}. Joining does not auto enroll you in
        a course.
      </p>
      <ul class="my-5 flex-1 space-y-2 text-sm text-neutral-700 dark:text-neutral-200">
        {membershipConfig.benefits.map((benefit) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-primary">
              ✓
            </span>
            <span>{benefit}</span>
          </li>
        ))}
      </ul>
      <p class="mb-4 text-xs text-neutral-600 dark:text-neutral-300">
        Early access starts {membershipConfig.earlyAccessDays} days before each
        course release
      </p>
      <Button
        url={pricingConfig.links.newsletter}
        event="joinMailingList"
        className="w-full justify-center !bg-[#8f1d2c] hover:!bg-[#ad2838] dark:!bg-[#a82335] dark:hover:!bg-[#c83345] focus-visible:!outline-2 focus-visible:!outline-offset-2 focus-visible:!outline-rose-400"
        type="fill"
      >
        {pricingConfig.callsToAction.member}
      </Button>
    </article>

    <article class="flex flex-col rounded-2xl border border-primary/15 bg-white/80 p-5 shadow-sm dark:bg-bg-secondary-dark md:p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-primary">
        Premium Courses
      </p>
      <h3 class="mt-2 text-xl font-semibold text-neutral-900 dark:text-white">
        Courses and Assessments
      </h3>
      <p class="mt-3 font-brand text-3xl text-primary">
        {coursePrice} <span class="text-base">once per course</span>
      </p>
      <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
        Courses are {pricingConfig.coursePaymentType} purchases when
        registration is live. Assessments are{" "}
        {pricingConfig.assessmentPriceLabel.toLowerCase()} separately.
      </p>
      <div
        class="my-4 rounded-xl border border-primary/15 bg-primary/5 p-3"
        data-feature="member-price-toggle"
      >
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-700 dark:text-neutral-200">
          Join for keeps
        </p>
        <div class="mt-2 flex gap-2">
          <button
            type="button"
            class="member-price-choice rounded-full border border-primary bg-primary px-3 py-1 text-xs font-semibold text-white"
            data-price-mode="member"
            aria-pressed="true"
            data-umami-event="memberPricingChoice"
          >
            Member
          </button>
          <button
            type="button"
            class="member-price-choice rounded-full border border-primary/20 px-3 py-1 text-xs font-semibold text-neutral-700 dark:text-neutral-200"
            data-price-mode="non-member"
            aria-pressed="false"
            data-umami-event="memberPricingChoice"
          >
            Non-member
          </button>
        </div>
        <p
          class="mt-2 text-xs leading-5 text-neutral-600 dark:text-neutral-300"
          data-member-price-copy
        >
          {pricingConfig.memberCoursePriceCopy}
        </p>
      </div>
      <ul class="mb-5 flex-1 space-y-2 text-sm text-neutral-700 dark:text-neutral-200">
        <li>
          {pricingConfig.paymentsLive
            ? "Course registration is open"
            : "Course registration is not open yet"}
        </li>
        <li>-</li>
        <li>Hardware, speed, and maintenance are additional costs</li>
      </ul>
      <Button
        url={pricingConfig.links.newsletter}
        event="joinMailingList"
        className="w-full justify-center"
        type="outline"
      >
        {pricingConfig.callsToAction.courses}
      </Button>
      <a
        class="mt-3 text-center text-sm font-semibold text-primary underline underline-offset-4"
        href={pricingConfig.links.assessment}
        data-umami-event="pricingPlanAction"
      >
        Ask about an assessment
      </a>
    </article>
  </div>
  <p class="max-w-4xl mx-auto mt-8 text-base leading-7 text-neutral-700 dark:text-neutral-200">
    Built for nonprofits first because too many teams are priced out of big
    software and ignored by consultants. We welcome everyone. Course purchases
    and tips help us publish more free guides to teams worldwide. Hardware,
    hosting, data, and maintenance may cost extra.
  </p>
  <p class="mx-auto mt-3 max-w-4xl text-base leading-7 text-neutral-700 dark:text-neutral-200">
    {siteConfig.teamClaim}
  </p>
  <div
    class="mt-5 grid gap-2 sm:grid-cols-2"
    data-feature="membership-course-rules"
  >
    <p class="rounded-xl border border-primary/10 p-3 text-base leading-7 text-neutral-700 dark:text-neutral-200">
      Become a Member
    </p>
    <p class="rounded-xl border border-primary/10 p-3 text-base leading-7 text-neutral-700 dark:text-neutral-200">
      New courses open to members {membershipConfig.earlyAccessDays} days early.
      One older course can be picked free with each release. The newest course
      stays paid for everyone.
    </p>
  </div>
  <script>
    const memberPriceChoices =
      document.querySelectorAll<HTMLButtonElement>("[data-price-mode]");
    const memberPriceCopy = document.querySelector<HTMLElement>(
      "[data-member-price-copy]",
    );
    memberPriceChoices.forEach((choice) => {
      choice.addEventListener("click", () => {
        const isMember = choice.dataset.priceMode === "member";
        memberPriceChoices.forEach((item) => {
          const selected = item === choice;
          item.setAttribute("aria-pressed", String(selected));
          item.classList.toggle("bg-primary", selected);
          item.classList.toggle("text-white", selected);
          item.classList.toggle("text-neutral-700", !selected);
          item.classList.toggle("dark:text-neutral-200", !selected);
        });
        if (memberPriceCopy) {
          const pricingSection =
            memberPriceCopy.closest<HTMLElement>("[data-member-copy]");
          memberPriceCopy.textContent = isMember
            ? pricingSection?.dataset.memberCopy || ""
            : pricingSection?.dataset.nonMemberCopy || "";
        }
      });
    });
  </script>
</section>
