---
import Button from "@/components/ui/Button.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = "Straight answers. No subscription trap.",
  description = "Read the free guides, contribute to the community, or request a project quote with a written scope.",
  showHeader = true,
} = Astro.props;

const plans = [
  {
    name: "Free",
    price: "$0",
    description: "Start learning with public guides and quickstarts.",
    features: [
      "Public courses and guides",
      "Self-paced learning",
      "Open Source tool discovery",
      "No paid subscription to read",
    ],
    cta: "Explore Quickstarts",
    url: "/courses",
  },
  {
    name: "Join For Keeps",
    price: "Free",
    description: "Learn with peers and help improve the knowledge we share.",
    features: [
      "Public community channels",
      "Share progress, tool reviews, pain points, or guide improvements",
      "One substantive post every 30 days to maintain access to gated learning materials",
      "No promotional post or cash subscription required",
    ],
    cta: "See the Community Rule",
    url: "/community",
  },
  {
    name: "Enterprise",
    price: "Custom quote",
    description: "Scoped technology assessment or hands-on project for your organization.",
    features: [
      "Needs and workflow discovery",
      "Tool, data, and operating-cost review",
      "Written scope and price before work begins",
      "Hosting, maintenance, and handover responsibilities agreed up front",
    ],
    cta: "Request an Assessment",
    url: "/contact",
  },
];
---

<section class="site-container py-8 md:py-10" aria-label="For Keeps pricing">
  {
    showHeader && (
      <div class="mb-5">
        <SectionHeader title={title} description={description} />
      </div>
    )
  }
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
    {
      plans.map((plan, index) => (
        <article
          class={`flex flex-col p-6 md:p-8 rounded-2xl border bg-white dark:bg-neutral-900 ${
            index === 1
              ? "border-primary shadow-lg"
              : "border-neutral-200 dark:border-neutral-800"
          }`}
        >
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-white">
            {plan.name}
          </h3>
          <p class="mt-4 text-3xl font-brand text-primary">{plan.price}</p>
          <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {plan.description}
          </p>
          <ul class="mt-6 mb-8 flex-1 space-y-3 text-sm text-neutral-600 dark:text-neutral-300">
            {plan.features.map((feature) => <li class="flex gap-2"><span class="text-primary" aria-hidden="true">✓</span><span>{feature}</span></li>)}
          </ul>
          <Button
            url={plan.url}
            className="w-full justify-center text-center"
            type={index === 1 ? "fill" : "outline"}
          >
            {plan.cta}
          </Button>
        </article>
      ))
    }
  </div>
  <p class="max-w-4xl mx-auto mt-8 text-sm text-neutral-600 dark:text-neutral-300">
    Community rule: at least one substantive contribution every 30 days is
    required to retain access to gated learning materials. Public resources on
    this site remain ungated. Software licenses, hardware, hosting, email,
    maintenance, and optional services may have separate costs.
  </p>
</section>
