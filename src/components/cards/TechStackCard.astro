---
import stack from "@/collections/stack.json";

const { displayIds } = Astro.props;
const filtered = displayIds?.length
  ? stack.filter(item => displayIds.includes(item.id))
  : stack;
---

<div class="stack-wrapper">
  <div class="stack-list">
    {filtered.map((item) => (
      <article class="stack-card">
        <img
          src={item.image}
          alt={item.alt}
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
          class="stack-image"
        />
        <div class="stack-text">
          <h3 class="stack-name">{item.name}</h3>
          <p class="stack-desc">{item.desc}</p>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .stack-wrapper {
    width: 100%;
  }

  .stack-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .stack-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(143, 185, 255, 0.24);
    border-radius: 1rem;
    background:
      linear-gradient(145deg, rgba(45, 109, 195, 0.16), rgba(15, 27, 45, 0.94)),
      var(--color-bg-secondary);
    box-shadow: 0 12px 32px rgba(11, 18, 32, 0.12);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .stack-card:hover {
    transform: translateY(-4px);
    border-color: rgba(143, 185, 255, 0.6);
    box-shadow: 0 18px 38px rgba(11, 18, 32, 0.2);
  }

  .stack-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #0f1b2d;
  }

  .stack-text {
    min-height: 8.5rem;
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
  }

  .stack-name {
    margin: 0;
    color: #f2f6fd;
    font-size: 1.05rem;
    line-height: 1.3;
    font-weight: 700;
  }

  .stack-desc {
    margin: 0.55rem 0 0;
    color: #c5d5e8;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  :global(.dark) .stack-card {
    background:
      linear-gradient(145deg, rgba(45, 109, 195, 0.3), rgba(15, 27, 45, 0.96)),
      var(--color-bg-secondary-dark);
  }

  @media (min-width: 768px) {
    .stack-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-card {
      transition: none;
    }
  }
</style>
