---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { pricingConfig } from "@/config/pricing";
---

<Layout
  lang="es-MX"
  title="For Keeps en español"
  description="Aprende a elegir y mantener herramientas digitales que tu organización pueda controlar."
>
  <main>
    <section class="site-container py-8 md:py-12">
      <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.12em] text-primary">
            Para organizaciones sin fines de lucro. Abierto a todas las personas.
          </p>
          <h1 class="font-brand text-5xl leading-tight text-neutral-900 dark:text-white md:text-7xl">
            Tus herramientas.
            <span class="block text-[#04a7a4]">Para siempre.</span>
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-700 dark:text-neutral-200">
            Antes de pagar por Salesforce, GoFundMe, Perplexity o DonorSearch,
            conoce tus opciones. Te ayudamos a comparar herramientas y entender
            qué necesita tu equipo para operarlas.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <Button
              url={pricingConfig.links.newsletter}
              event="spanishJoinMailingList"
              type="fill"
            >
              Únete a la lista de correo
            </Button>
            <Button
              url={pricingConfig.links.learning}
              event="spanishBrowseCourses"
              type="outline"
            >
              Explora los cursos
            </Button>
          </div>
        </div>
        <div class="rounded-2xl border border-[#04a7a4]/30 bg-gradient-to-br from-[#e7f7f4] to-white p-6 shadow-sm dark:from-[#103b3b] dark:to-[#0b2028] md:p-8">
          <p class="text-sm font-bold uppercase tracking-[0.1em] text-[#087c77] dark:text-[#83d9d0]">
            Empieza por lo que tienes
          </p>
          <h2 class="mt-2 font-brand text-3xl text-neutral-900 dark:text-white">
            Aprende. Prueba. Decide.
          </h2>
          <ul class="mt-5 space-y-4 text-neutral-700 dark:text-neutral-200">
            <li><strong>Guías claras</strong> para entender las opciones y sus costos</li>
            <li><strong>Prácticas con datos de ejemplo</strong> antes de tocar registros reales</li>
            <li><strong>Pasos propios</strong> para que tu equipo pueda aprender a su ritmo</li>
            <li><strong>Sin cargos sorpresa</strong> en las guías públicas</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="site-container py-6 md:py-10" id="opciones">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-brand text-3xl text-neutral-900 dark:text-white md:text-4xl">
          Guías gratuitas. Ayuda con precio claro.
        </h2>
        <p class="mt-3 leading-7 text-neutral-700 dark:text-neutral-200">
          Las guías y la lista de correo son gratis. Los cursos y el trabajo
          personalizado muestran su precio o alcance antes de que decidas.
          Cada apoyo nos ayuda a crear más recursos abiertos.
        </p>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="rounded-xl border border-primary/15 bg-white/80 p-5 dark:bg-bg-secondary-dark">
          <h3 class="font-semibold text-neutral-900 dark:text-white">Guías públicas</h3>
          <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-200">Gratis. Léelas sin crear una cuenta.</p>
        </article>
        <article class="rounded-xl border border-rose-700 bg-rose-50/60 p-5 dark:border-rose-500 dark:bg-rose-950/30">
          <h3 class="font-semibold text-rose-900 dark:text-rose-200">For Keeps por correo</h3>
          <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-200">La membresía es gratis y no inicia una suscripción.</p>
        </article>
        <article class="rounded-xl border border-primary/15 bg-white/80 p-5 dark:bg-bg-secondary-dark">
          <h3 class="font-semibold text-neutral-900 dark:text-white">Cursos y evaluaciones</h3>
          <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-200">Opciones de pago con costos y alcance claros.</p>
        </article>
      </div>
    </section>
  </main>
</Layout>
