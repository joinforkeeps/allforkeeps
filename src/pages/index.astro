---
import Layout from "@/layouts/Layout.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Pricing from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import Button from "@/components/ui/Button.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import TechStackCard from "@/components/cards/TechStackCard.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import {
  LayoutDashboard,
  Layers,
  Bot,
  Code,
  PenTool,
  Rocket,
  GitFork,
  ChartNoAxesColumnIncreasing,
  ArrowRight,
  Compass,
  Triangle,
  Sun,
  CircleDot,
  Orbit,
  Anvil,
} from "@lucide/astro";

const faqItems = [
  {
    question: "What’s free?",
    answer:
      "Select courses are available at no charge. Software, hosting, payment processing, hardware, and third-party support are separate unless explicitly listed. For Keeps provides education and advice, not a turnkey setup, migration, hosting, or ongoing system administration.",
  },
  {
    question: "What is the benefit of self-hosting?",
    answer:
      "Imagine deploying enterprise-grade, ai-powered, open-source tools directly on infrastructure you control for free. No one can ever force update your app, add future pricing, or sunset the app. Take ownership back.",
  },
  {
    question: "Do I need coding experience?",
    answer:
      "No prior technical background required. Our gamified learning will guide admins to volunteers, each click at a time.",
  },
  {
    question: "Will you build or install our tools for us?",
    answer:
      "No. We help you choose tools, walk you through installation, and guide you on how to use them effectively. Your team or a technical provider handles installation, migration, maintenance, and security.",
  },
  {
    question: "Are your courses open source?",
    answer:
      "No. The platform is private and your profile can be confidential or shared in the community. Our goal is to teach you about the tools available, including open-source and self-hosted options. The courses themselves are not open-source software.",
  },
];

const features = [
  {
    icon: "/assets/icon/structure.png",
    title: "Self Led Quickstarts",
    desc: "Interactive courses built for nonprofit admins, staff, and volunteers.",
  },
  {
    icon: "/assets/icon/components.png",
    title: "Open Source Stacks",
    desc: "Curated suites from CRMs to self-hosted AI built to replace costly SaaS.",
  },
  {
    icon: "/assets/icon/document.png",
    title: "Clear Guides & Blueprints",
    desc: "Point-and-click instructions walking you through setup and management.",
  },
  {
    icon: "/assets/icon/fast.png",
    title: "Zero Hidden Fees",
    desc: "No freemium options or per-user price hikes. What you build is yours to keep.",
  },
  {
    icon: "/assets/icon/motion.png",
    title: "Our Learning Engine",
    desc: "Earn achievements and master self-hosting through engaging progress paths.",
  },
  {
    icon: "/assets/icon/customize.png",
    title: "Nonprofit Assessments",
    desc: "Not sure where to start? We offer paid asssessments for custom tech stacks with full operational guarantees.",
  },
];

const problems = [
  {
    icon: "/assets/icon/battery.png",
    title: "Find your tools",
    desc: "Get recommendations for donor management, grant research, fundraising, and AI.",
  },
  {
    icon: "/assets/icon/clock.png",
    title: "Learn to use them",
    desc: "Take practical courses that teach your team what to do next.",
  },
  {
    icon: "/assets/icon/bell.png",
    title: "Get personalized advice",
    desc: "Pay for an assessment or consulting focused on your organization’s needs.",
  },
];

const useCases = [
  {
    icon: ChartNoAxesColumnIncreasing,
    label: "Find Donors",
    desc: "Find and Track Donors without software guesswork",
  },
  {
    icon: GitFork,
    label: "Stop buying tools",
    desc: "Stop buying tools your team can’t use.",
  },
  {
    icon: PenTool,
    label: "eLearning",
    desc: "Learn the tools behind better fundraising.",
  },
  {
    icon: Bot,
    label: "Local AI Tools",
    desc: "Run secure, private AI models on your PC",
  },
  {
    icon: Code,
    label: "Secure Data",
    desc: "Pay for expertise. Know what software is free.",
  },
  {
    icon: Rocket,
    label: "Custom Courses",
    desc: "Tailored options built for nonprofits",
  },
];

const logos = [
  { name: "Open-source CRM", icon: Compass },
  { name: "Find Donors", icon: Triangle },
  { name: "No Software Spending", icon: Sun },
  { name: "Pay for Expertise", icon: CircleDot },
  { name: "Learn new skills", icon: Orbit },
  { name: "Self-Hosted Tools", icon: Anvil },
];
---

<Layout
  title="For Keeps | Nonprofit Technology Courses & Consulting"
  description="Learn about selfhosting opensource tools for finding donors, grant research, and fundraising. Explore free and paid courses, technology assessments, and personalised consulting for nonprofits."
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Logo Strip -->
  <section class="py-12 md:py-16 site-container">
    <p class="text-center text-sm text-neutral-400 dark:text-neutral-500 mb-6">
      Supporting the Nonprofit Community and Open Source Software.
      Please support the official releases.
    </p>
    <div
      class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 md:gap-8 opacity-75"
    >
      {
        logos.map((logo) => (
          <div class="flex items-center gap-2 px-4 py-2 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg">
            <logo.icon class="w-4 h-4 text-primary" />
            <span class="text-sm font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-300">
              {logo.name}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-16 md:py-24 bg-neutral-50 dark:bg-neutral-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-brand mb-4">
          Better tools. Clear advice. Skills your team keeps.
        </h2>
        <p class="text-neutral-600 dark:text-neutral-300">
          For Keeps helps you choose and configure available open source tools that suit your mission. Then we teach you to use them. Keep what works. Replace what doesn’t. Pay for help and not unnecessary subscriptions.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          problems.map((problem) => (
            <div class="p-6 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm">
              <img
                src={problem.icon}
                alt={problem.title}
                width="64"
                height="64"
                class="w-16 h-16 mb-4 object-contain"
              />
              <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
                {problem.title}
              </h3>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
                {problem.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Solution narrative -->
  <section class="py-16 md:py-24 site-container">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-brand mb-6">
        A Community Built Engine, Not Just Courses
      </h2>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed text-lg">
        For Keeps brings together 10 years of nonprofit experience to offer a
        straightforward alternative to traditonal consulting. Building it
        yourself! Digital technology can give you freedom, but it can also take
        your freedom away.
        <p
          class="mt-4 text-neutral-600 dark:text-neutral-300 leading-relaxed text-lg"
        >
          Remove the need for forced subscriptions, renewals, and cloud only models. Our community believes in the private
          ownership of data, media, games, and internet. We combine eLearning,
          interactive quickstarts, and modern D&D elements to help you skip the
          code and budget questions.
        </p>
      </p>
    </div>

    <!-- Features Grid -->
    <section class="py-16 md:py-24 site-container">
      <SectionHeader
        title="Know your options before you renew."
        description="You don't need another subscription. You need a better option."
        />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        {
          features.map((feature) => (
            <div class="h-full p-6 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm">
              <img
                src={feature.icon}
                alt={feature.title}
                width="64"
                height="64"
                class="w-16 h-16 mb-4 object-contain"
              />
              <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
                {feature.title}
              </h3>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
                {feature.desc}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Dashboard / Product Preview -->
    <section class="py-16 md:py-24 site-container">
      <SectionHeader
        title="The For Keeps Guarantee."
        description="For years, traditional consultants gatekept your potential. Salesforce, Slack, and Claude want you locked into their seperate ecosystems, but we all know they change too often, get acquired quickly, and are not reliable options for low budgets and orgs resistant to AI. So we say try more options for FREE first. 
        The For Keeps Guarantee: You can get enterprise software completely free. Join For Keeps to learn how to install it and build them on your own."
      />
      <div class="mt-8 max-w-4xl mx-auto">
        <BrowserFrame url="allforkeeps.com/dashboard">
          <div class="flex h-[320px] md:h-[380px]">
            <aside
              class="hidden sm:flex flex-col w-16 border-r border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 py-4 px-3 gap-2"
            >
              <div
                class="w-7 h-7 mx-auto rounded-md bg-primary/15 flex items-center justify-center text-primary font-bold text-xs"
              >
                AFK
              </div>
              <div
                class="w-full h-8 rounded-md bg-primary/20 flex items-center justify-center"
              >
                <LayoutDashboard class="w-4 h-4 text-primary" />
              </div>
              <div
                class="w-full h-8 rounded-md flex items-center justify-center"
              >
                <Layers class="w-4 h-4 text-neutral-400" />
              </div>
            </aside>
            <div
              class="flex-1 p-4 md:p-6 flex flex-col gap-4 overflow-hidden bg-white dark:bg-neutral-950"
            >
              <div class="flex items-center justify-between">
                <div>
                  <h3
                    class="text-sm font-semibold text-neutral-800 dark:text-neutral-100"
                  >
                    Impact Summary
                  </h3>
                  <p class="text-[10px] text-neutral-400">
                    Total active time: 1,420 hours
                  </p>
                </div>
                <span
                  class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border border-emerald-500/30 bg-emerald-500/5 text-emerald-600 text-[10px] font-medium"
                  >100% Owned</span
                >
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div
                  class="p-3 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900"
                >
                  <span class="text-[10px] text-neutral-400 uppercase"
                    >SaaS Fees Saved</span
                  ><span class="block text-base font-brand text-primary mt-1"
                    >$48.2k</span
                  >
                </div>
                <div
                  class="p-3 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900"
                >
                  <span class="text-[10px] text-neutral-400 uppercase"
                    >Active Courses</span
                  ><span
                    class="block text-base font-brand text-neutral-800 dark:text-white mt-1"
                    >342</span
                  >
                </div>
                <div
                  class="p-3 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900"
                >
                  <span class="text-[10px] text-neutral-400 uppercase"
                    >Open Guides</span
                  ><span
                    class="block text-base font-brand text-neutral-800 dark:text-white mt-1"
                    >24</span
                  >
                </div>
              </div>
              <div
                class="flex-1 rounded border border-neutral-200 dark:border-neutral-800 p-3 bg-neutral-50 dark:bg-neutral-900"
              >
                <div
                  class="grid grid-cols-12 text-[10px] uppercase text-neutral-400 mb-2 font-medium"
                >
                  <span class="col-span-6">Stack Module</span><span
                    class="col-span-3">Ownership</span
                  ><span class="col-span-3 text-right">Cost</span>
                </div>
                <div class="space-y-2 text-xs">
                  <div
                    class="grid grid-cols-12 items-center py-1 border-b border-neutral-200 dark:border-neutral-800"
                  >
                    <span
                      class="col-span-6 font-medium text-neutral-800 dark:text-neutral-200"
                      >Twenty CRM</span
                    ><span class="col-span-3 text-primary">Self-Hosted</span
                    ><span class="col-span-3 text-right text-emerald-600"
                      >$0/mo</span
                    >
                  </div>
                  <div
                    class="grid grid-cols-12 items-center py-1 border-b border-neutral-200 dark:border-neutral-800"
                  >
                    <span
                      class="col-span-6 font-medium text-neutral-800 dark:text-neutral-200"
                      >Ollama</span
                    ><span class="col-span-3 text-primary">Self-Hosted</span
                    ><span class="col-span-3 text-right text-emerald-600"
                      >$0/mo</span
                    >
                  </div>
                  <div class="grid grid-cols-12 items-center py-1">
                    <span
                      class="col-span-6 font-medium text-neutral-800 dark:text-neutral-200"
                      >CiviCRM</span
                    ><span class="col-span-3 text-primary">Self-Hosted</span
                    ><span class="col-span-3 text-right text-emerald-600"
                      >$0/mo</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </BrowserFrame>
      </div>
    </section>

    <!-- Use Cases Grid -->
    <section class="py-16 md:py-24 site-container">
      <SectionHeader
        title="Built for Every Nonprofit Need"
        description="Whether you need a donor database, private AI models, or automated volunteer onboarding, our open-source blueprints adapt to your mission."
      />
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mt-8">
        {
          useCases.map(({ icon: Icon, label, desc }) => (
            <div class="flex flex-col items-center p-4 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-center shadow-sm">
              <Icon class="w-6 h-6 text-primary mb-2" />
              <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">
                {label}
              </span>
              <span class="text-xs text-neutral-400 mt-1">{desc}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="py-16 md:py-24 site-container">
      <SectionHeader
        title="Built on Free & Open-Source Foundations"
        description="We test, configure, and refine leading open-source tools so your team can deploy them smoothly."
      />
      <div class="mt-8"><TechStackCard /></div>
    </section>

    <!-- Pricing Preview with Free, Community, Nonprofit Tiers -->
    <Pricing
      title="What’s free. What’s paid. What’s separate."
      description="All open source tools are free to build and use. Building them is the barrier, therefore, our consulting work and expertise is paid. The base courses are free."
    />

    <!-- FAQ -->
    <FAQ title="Frequently Asked Questions" items={faqItems} />

    <!-- Blog -->
    <div class="py-16 md:py-24">
      <BlogSection title="Guides & Open-Source Insights" />
    </div>

    <!-- Final CTA -->
    <section
      class="py-12 md:py-20 site-container rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm text-center"
    >
      <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-brand mb-4">
          Ready to Take Control of Your Tech?
        </h2>
        <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
          Join our community mailing list to receive free open-source guides,
          step-by-step tech quickstarts, and updates—no noise, no high-pressure
          sales calls.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button url="/contact" className="text-lg px-8 py-3">
            Join the Mailing List <ArrowRight size={18} class="ml-2" />
          </Button>
          <Button url="/courses" className="text-lg px-8 py-3">
            Explore Quickstarts
          </Button>
        </div>
      </div>
    </section>
  </section>
</Layout>
