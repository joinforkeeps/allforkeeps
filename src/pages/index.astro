---
import Layout from "@/layouts/Layout.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Pricing from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import Button from "@/components/ui/Button.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import TechStackCard from "@/components/cards/TechStackCard.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import JourneyChooser from "@/components/home/JourneyChooser.astro";
import ClientScenarios from "@/components/home/ClientScenarios.astro";
import OpenSourceGuide from "@/components/home/OpenSourceGuide.astro";
import ForKeepsSocials from "@/components/sections/ForKeepsSocials.astro";
import {
  LayoutDashboard,
  Layers,
  Bot,
  Code,
  PenTool,
  Rocket,
  GitFork,
  ChartNoAxesColumnIncreasing,
  ArrowRight,
  Compass,
  Triangle,
  Sun,
  CircleDot,
  Orbit,
  Anvil,
} from "@lucide/astro";

const faqItems = [
  {
    question: "What does open source mean?",
    answer:
      "Open source means the code is public and free to use and change; it does not come in a box that you download once.",
  },
  {
    question: "What’s free?",
    answer:
      "Our guides are free to read. Courses and assessments are paid. Paid members can choose one eligible older course free after each new course release.",
  },
  {
    question: "What is the benefit of self-hosting?",
    answer:
      "Self-hosting can give your organisation more control over its data, software, and exit plan. It also makes your team responsible for updates, backups, security, and infrastructure. We explain those trade offs instead of promising that ownership means zero cost or effort.",
  },
  {
    question: "Do we need coding experience?",
    answer:
      "You can start without a coding background. Our guides explain the steps and the decisions; some tools still require technical setup or outside help.",
  },
  {
    question: "Will you build or install our tools for us?",
    answer:
      "We publish guides and offer project support when your team wants help choosing, setting up, or moving tools.",
  },
  {
    question: "What do your guides cover?",
    answer:
      "We cover how tools work, what it takes to run them, and how to keep control of your data.",
  },
];

const features = [
  {
    icon: "/assets/icon/structure.png",
    title: "Self-Led Quickstarts",
    desc: "Work through practical steps at your team’s pace, with sample data before you touch live records.",
  },
  {
    icon: "/assets/icon/components.png",
    title: "Open-source stacks",
    desc: "Compare tools for fundraising, operations, and local AI, including the trade-offs and operating needs.",
  },
  {
    icon: "/assets/icon/document.png",
    title: "Clear Guides",
    desc: "Know what a tool does, what it depends on, how to maintain it, and how to leave.",
  },
  {
    icon: "/assets/icon/fast.png",
    title: "Zero Hidden Fees",
    desc: "No surprise charge for our free guides. Paid work has a written scope and price before it starts.",
  },
];

const problems = [
  {
    icon: "/assets/icon/battery.png",
    title: "Find your tools",
    desc: "Get recommendations for donor management, grant research, fundraising, and AI",
  },
  {
    icon: "/assets/icon/clock.png",
    title: "Learn to use them",
    desc: "Take practical courses that teach your team what to do next",
  },
  {
    icon: "/assets/icon/bell.png",
    title: "Get personalized advice",
    desc: "Pay for an assessment or consulting focused on your organisation’s needs",
  },
];

const useCases = [
  {
    icon: ChartNoAxesColumnIncreasing,
    label: "Find Donors",
    desc: "Find and Track Donors without paying for data",
  },
  {
    icon: GitFork,
    label: "Stop Buying Tools",
    desc: "Stop buying tools your team doesn't use",
  },
  {
    icon: PenTool,
    label: "eLearning",
    desc: "Learn the tools behind better fundraising",
  },
  {
    icon: Bot,
    label: "Local AI Tools",
    desc: "Run secure, private AI models on your PC",
  },
  {
    icon: Code,
    label: "Data Control",
    desc: "Plan access, backups, and a workable exit before sensitive records move",
  },
  {
    icon: Rocket,
    label: "Custom Courses",
    desc: "Tailored options built for nonprofits",
  },
];

const logos = [
  { name: "Nonprofit CRM", icon: Compass },
  { name: "Find Donors", icon: Triangle },
  { name: "Know the real costs", icon: Sun },
  { name: "Pay for Expertise", icon: CircleDot },
  { name: "Learn new skills", icon: Orbit },
  { name: "Self-Hosted Tools", icon: Anvil },
];
---

<Layout
  title="For Keeps"
  description="Learn to choose, build, and maintain nonprofit technology you control. Start with practical open-source guides; pay for scoped expertise when you need it."
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Logo Strip -->
  <section class="py-3 md:py-4 site-container">
    <p class="text-center text-sm text-neutral-400 dark:text-neutral-500 mb-6">
      Nonprofit technology education for teams who want more control and a clear
      exit.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 md:gap-8 opacity-75">
      {logos.map((logo) => (
        <div class="flex items-center gap-2 px-4 py-2 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg">
          <logo.icon class="w-4 h-4 text-primary" />
          <span class="text-sm font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-300">
            {logo.name}
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-4 md:py-6 bg-neutral-50 dark:bg-neutral-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-6">
        <h2 class="text-3xl md:text-4xl font-brand mb-4">
          The tools are only half the story
        </h2>
        <p class="text-neutral-600 dark:text-neutral-300">
          We help you compare open-source options, the work behind them, and
          what your team can take on.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {problems.map((problem) => (
          <div class="p-6 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm">
            <img
              src={problem.icon}
              alt={problem.title}
              width="64"
              height="64"
              class="w-16 h-16 mb-4 object-contain"
            />
            <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
              {problem.title}
            </h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
              {problem.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <JourneyChooser />
  <ClientScenarios />

  <!-- Solution narrative -->
  <section class="py-4 md:py-6 site-container">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-brand mb-6">
        A Community Built Engine, Not Just Courses
      </h2>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed text-lg">
        We took our years of nonprofit experience and went open, to offer a
        straightforward alternative to traditional consulting and closed
        ecosystems. Learn the tools, build what fits, and keep the skills.
        Technology can give your team freedom, but only when you cut the chord
        from Salesforce.
      </p>
      <p class="mt-4 text-neutral-600 dark:text-neutral-300 leading-relaxed text-lg">
        We skip the admin work and make it simple with interactive courses,
        quickstarts, and a community that believes in ownership. No managed
        services just to keep your average system alive. No booking an
        assessment or a sales call just to receive a bill with no work
        completed. No pretending that a Salesforce Administrator title is
        anything more than achievement points.
      </p>
    </div>

    <!-- Features Grid -->
    <section class="py-4 md:py-6 site-container">
      <SectionHeader
        title="Know your options, don't renew"
        description="You don't need another subscription. You need a better option."
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
        {features.map((feature) => (
          <div class="h-full p-6 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm">
            <img
              src={feature.icon}
              alt={feature.title}
              width="64"
              height="64"
              class="w-16 h-16 mb-4 object-contain"
            />
            <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
              {feature.title}
            </h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
              {feature.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Dashboard / Product Preview -->
    <section class="py-4 md:py-6 site-container">
      <SectionHeader
        title="The For Keeps Guarantee"
        description="We teach your team to evaluate tools before it commits. Every stack has dependencies and upkeep; our learning tracker and dashboard previews use sample data."
      />
      <div class="mt-8 max-w-4xl mx-auto">
        <BrowserFrame url="allforkeeps.com/example">
          <div class="flex h-[320px] md:h-[380px]">
            <aside class="hidden sm:flex flex-col w-16 border-r border-neutral-200 dark:border-[#125452] bg-neutral-50 dark:bg-[#072d30] py-4 px-3 gap-2">
              <div class="w-7 h-7 mx-auto rounded-md bg-primary/15 flex items-center justify-center text-primary dark:text-[#a7f1e8] font-bold text-xs">
                AFK
              </div>
              <div class="w-full h-8 rounded-md bg-primary/20 flex items-center justify-center">
                <LayoutDashboard class="w-4 h-4 text-primary dark:text-[#a7f1e8]" />
              </div>
              <div class="w-full h-8 rounded-md flex items-center justify-center">
                <Layers class="w-4 h-4 text-neutral-400 dark:text-[#a7c7c3]" />
              </div>
            </aside>
            <div class="flex-1 p-4 md:p-6 flex flex-col gap-4 overflow-hidden bg-white dark:bg-dashboard-teal">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-sm font-semibold text-neutral-800 dark:text-[#effffc]">
                    Impact Summary
                  </h3>
                  <p class="text-[10px] text-neutral-400 dark:text-[#b7ddd9]">
                    Your Org Workspace · sample data
                  </p>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border border-emerald-500/30 bg-emerald-500/5 text-emerald-600 dark:text-emerald-300 text-[10px] font-medium">
                  Plan ownership
                </span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div class="p-3 rounded border border-neutral-200 dark:border-[#76c9be]/20 bg-neutral-50 dark:bg-[#0b4847]">
                  <span class="text-[10px] text-neutral-400 dark:text-[#b7ddd9] uppercase">
                    Savings
                  </span>
                  <span class="block text-base font-brand text-primary mt-1">
                    $580.75
                  </span>
                </div>
                <div class="p-3 rounded border border-neutral-200 dark:border-[#76c9be]/20 bg-neutral-50 dark:bg-[#0b4847]">
                  <span class="text-[10px] text-neutral-400 dark:text-[#b7ddd9] uppercase">
                    Course status
                  </span>
                  <span class="block text-base font-brand text-neutral-800 dark:text-white mt-1">
                    In progress
                  </span>
                </div>
                <div class="p-3 rounded border border-neutral-200 dark:border-[#76c9be]/20 bg-neutral-50 dark:bg-[#0b4847]">
                  <span class="text-[10px] text-neutral-400 dark:text-[#b7ddd9] uppercase">
                    Next chapter
                  </span>
                  <span class="block text-base font-brand text-neutral-800 dark:text-white mt-1">
                    It was a trap.
                  </span>
                </div>
              </div>
              <p class="text-[10px] leading-relaxed text-neutral-500 dark:text-[#c7e4df]">
                Keeper says: Look out for traps! You can avoid mimics by doing a
                better job.
              </p>
              <div class="flex-1 rounded border border-neutral-200 dark:border-[#76c9be]/20 p-3 bg-neutral-50 dark:bg-[#0b4847]">
                <div class="grid grid-cols-12 text-[10px] uppercase text-neutral-400 dark:text-[#b7ddd9] mb-2 font-medium">
                  <span class="col-span-6">Recent Achievements</span>
                  <span class="col-span-3">Platform</span>
                  <span class="col-span-3 text-right">Instructor</span>
                </div>
                <div class="space-y-2 text-xs">
                  <div class="grid grid-cols-12 items-center py-1 border-b border-neutral-200 dark:border-[#76c9be]/20">
                    <span class="col-span-6 font-medium text-neutral-800 dark:text-[#effffc]">
                      Twenty CRM
                    </span>
                    <span class="col-span-3 text-primary dark:text-[#a7f1e8]">
                      Docker
                    </span>
                    <span class="col-span-3 text-right text-dashboard-orange">
                      Keeper
                    </span>
                  </div>
                  <div class="grid grid-cols-12 items-center py-1 border-b border-neutral-200 dark:border-[#76c9be]/20">
                    <span class="col-span-6 font-medium text-neutral-800 dark:text-[#effffc]">
                      Ollama
                    </span>
                    <span class="col-span-3 text-primary dark:text-[#a7f1e8]">
                      Docker
                    </span>
                    <span class="col-span-3 text-right text-dashboard-orange">
                      Keeper
                    </span>
                  </div>
                  <div class="grid grid-cols-12 items-center py-1">
                    <span class="col-span-6 font-medium text-neutral-800 dark:text-[#effffc]">
                      CiviCRM
                    </span>
                    <span class="col-span-3 text-primary dark:text-[#a7f1e8]">
                      Docker
                    </span>
                    <span class="col-span-3 text-right text-dashboard-orange">
                      Keeper
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </BrowserFrame>
      </div>
    </section>

    <!-- Use Cases Grid -->
    <section class="py-4 md:py-6 site-container">
      <SectionHeader
        title="Technology for Good"
        description="Whether you need a donor database, private AI models, or automated volunteer onboarding, our open-source blueprints adapt to your mission"
      />
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mt-8">
        {useCases.map(({ icon: Icon, label, desc }) => (
          <div class="flex flex-col items-center p-4 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-center shadow-sm">
            <Icon class="w-6 h-6 text-primary mb-2" />
            <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">
              {label}
            </span>
            <span class="text-xs text-neutral-400 mt-1">{desc}</span>
          </div>
        ))}
      </div>
    </section>

    <OpenSourceGuide />

    <!-- Tech Stack -->
    <section class="py-4 md:py-6 site-container">
      <SectionHeader
        title="Chosen with care"
        description="From nonprofit CRMs to local AI, compare pros and cons, setup needs, maintenance, and operating costs"
      />
      <div class="mt-8">
        <TechStackCard />
      </div>
    </section>

    <!-- Pricing Preview with Free, Community, Nonprofit Tiers -->
    <Pricing
      title="Pricing"
      description="Book an assessment for custom recommendations, account required for premium courses"
    />

    <!-- FAQ -->
    <FAQ title="Frequently Asked Questions" items={faqItems} />

    <!-- Blog -->
    <div class="py-4 md:py-6">
      <BlogSection title="Guides and open-source insights" />
    </div>

    <!-- Final CTA -->
    <section class="py-6 md:py-10 site-container rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-brand mb-4">
          Ready to own your tools?
        </h2>
        <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
          Start with a quickstart. If the stack is bigger than your team can
          take on alone, we can scope an assessment and map the next steps
          together.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button
            url="/assessment"
            event="footerAssessment"
            className="text-lg px-8 py-3"
          >
            Book an Assessment <ArrowRight size={18} class="ml-2" />
          </Button>
          <Button
            url="https://learn.allforkeeps.com/lms/courses"
            event="browseCourses"
            className="text-lg px-8 py-3"
          >
            Browse Courses
          </Button>
        </div>
      </div>
    </section>
    <section class="site-container py-5" aria-labelledby="home-socials-title">
      <SectionHeader
        title="Find us around the web"
        description="Enter the Dungeon, Meet Keeper"
      />
      <ForKeepsSocials />
    </section>
  </section>
</Layout>
