---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
---

<Layout
  title="Create a community account"
  description="Create an account to submit field notes to the For Keeps community."
>
  <main class="site-container py-8 md:py-12">
    <PageHeader
      title="Get your crew pass."
      description="Create an account to post field notes. Posts go to review before they appear on the public board."
    />
    <div class="mx-auto max-w-xl rounded-2xl border border-primary/20 bg-white p-6 dark:bg-[#0f1b2d] md:p-8">
      <form id="sign-up-form" class="space-y-5">
        <label class="block text-sm font-medium" for="email">
          Email address
          <input id="email" name="email" type="email" autocomplete="email" required
            class="mt-2 w-full rounded-lg border border-neutral-300 bg-transparent px-4 py-3 dark:border-neutral-700" />
        </label>
        <label class="block text-sm font-medium" for="password">
          Password
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required
            class="mt-2 w-full rounded-lg border border-neutral-300 bg-transparent px-4 py-3 dark:border-neutral-700" />
        </label>
        <button id="sign-up-submit" type="submit"
          class="w-full rounded-lg bg-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-primary-strong disabled:cursor-not-allowed disabled:opacity-60">
          Create account
        </button>
        <p id="sign-up-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
      <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-300">
        Already have an account? <a class="font-semibold text-primary underline" href="/sign-in?next=/community">Sign in</a>.
      </p>
      <p class="mt-4 text-xs leading-6 text-neutral-500 dark:text-neutral-400">
        Use a password you do not use elsewhere. Public posts are reviewed, and the community board is not a place for donor data, passwords, API keys, or private access links.
      </p>
    </div>
  </main>
</Layout>

<script>
  import { getLocalRedirectTarget, getSupabaseClient } from "@/lib/supabase";

  const form = document.querySelector<HTMLFormElement>("#sign-up-form");
  const status = document.querySelector<HTMLElement>("#sign-up-status");
  const submit = document.querySelector<HTMLButtonElement>("#sign-up-submit");
  const supabase = getSupabaseClient();

  if (!supabase && status && submit) {
    status.textContent =
      "Account creation is not available yet. The dedicated For Keeps Supabase settings still need to be configured.";
    status.className = "text-sm text-amber-700 dark:text-amber-300";
    submit.disabled = true;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status || !submit) return;
    if (!supabase) {
      status.textContent = "Account creation is unavailable until account services are configured.";
      return;
    }

    const data = new FormData(form);
    const email = String(data.get("email") || "").trim();
    const password = String(data.get("password") || "");
    const next = getLocalRedirectTarget(
      new URLSearchParams(window.location.search).get("next"),
    );
    const emailRedirectTo = new URL(
      `/sign-in?next=${encodeURIComponent(next)}`,
      window.location.origin,
    ).toString();

    submit.disabled = true;
    status.textContent = "Preparing your crew pass...";
    status.className = "text-sm text-neutral-600 dark:text-neutral-300";

    try {
      const { data: result, error } = await supabase.auth.signUp({
        email,
        password,
        options: { emailRedirectTo },
      });

      if (error) {
        status.textContent = error.message;
        status.className = "text-sm text-red-700 dark:text-red-300";
        return;
      }

      if (result.session) {
        window.location.assign(next);
        return;
      }

      status.textContent =
        "Account created. Check your email to confirm it, then sign in to post.";
      status.className = "text-sm text-emerald-700 dark:text-emerald-300";
    } catch (error) {
      console.error("Community account creation failed", error);
      status.textContent = "We could not reach the account service. Try again later.";
      status.className = "text-sm text-red-700 dark:text-red-300";
    } finally {
      submit.disabled = false;
    }
  });
</script>
