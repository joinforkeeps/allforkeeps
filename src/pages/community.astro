---
import Layout from "@/layouts/Layout.astro";
import ForKeepsSocials from "@/components/sections/ForKeepsSocials.astro";
import { membershipConfig } from "@/config/membership";
import socials from "@/data/for-keeps-socials.json";

const linktreeUrl =
  socials.find((social) => social.name === "Linktree")?.url || "/assessment";
const starters = [
  {
    key: "tool-cost",
    label: "The cost behind the price tag",
    text: "A tool cost our team did not expect was...",
  },
  {
    key: "data-exit",
    label: "Plan the exit",
    text: "Before choosing a platform, we want to know how to export...",
  },
  {
    key: "team-training",
    label: "Train the whole crew",
    text: "One thing that would make this tool easier for our team to learn is...",
  },
  {
    key: "first-step",
    label: "Start small",
    text: "Our first safe test with sample data could be...",
  },
];
---

<Layout
  title="Community | For Keeps"
  description="Share nonprofit technology field notes, questions, and practical lessons with the For Keeps community."
>
  <main class="site-container fk-community">
    <header class="fk-community-hero">
      <p class="fk-community-kicker">JOIN THE CREW / FIELD NOTES</p>
      <h1>Build skills. Share what works.</h1>
      <p>
        Nonprofit teams, grassroots organisers, volunteers, and open-source
        learners: bring the question that is slowing you down, the lesson you
        just earned, or the tool your crew is testing.
      </p>
      <a
        class="fk-community-cta"
        href={linktreeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Find the community channels <span aria-hidden="true">↗</span>
      </a>
    </header>

    <section class="fk-post-room" aria-labelledby="post-room-title">
      <div class="fk-post-intro">
        <p class="fk-community-kicker">THE FIELD BOARD</p>
        <h2 id="post-room-title">Drop a useful note. Help the next crew.</h2>
        <p>
          Community posting is paused while this page is being rebuilt. The
          prompts below remain as ideas for future field notes.
        </p>
      </div>

      <div class="fk-post-grid">
        <div class="fk-post-composer">
          <div
            id="community-auth-note"
            class="fk-community-status"
            role="status"
            aria-live="polite"
          >
            The field-note board is currently read-only.
          </div>
          <p
            id="community-post-status"
            class="fk-community-status"
            role="status"
            aria-live="polite"
          ></p>

          <form id="community-post-form" hidden>
            <label class="fk-field-label" for="community-prompt">
              Pick a prompt
            </label>
            <select id="community-prompt" name="prompt_key" required>
              {starters.map((starter) => (
                <option value={starter.key}>{starter.label}</option>
              ))}
              <option value="open-note">Write your own field note</option>
            </select>

            <div class="fk-prompt-buttons" aria-label="Starter prompts">
              {starters.map((starter) => (
                <button
                  class="fk-prompt-button"
                  type="button"
                  data-starter={starter.key}
                  data-template={starter.text}
                >
                  {starter.label}
                </button>
              ))}
            </div>

            <label class="fk-field-label" for="community-body">
              Your field note
            </label>
            <textarea
              id="community-body"
              name="body"
              rows="6"
              minlength="20"
              maxlength="2000"
              required
              placeholder="What did you learn, what are you testing, or where are you stuck? (20–2,000 characters)"
            ></textarea>
            <p class="fk-safety-note">
              Keep it safe for the whole crew: do not post donor records,
              personal information, passwords, API keys, or private access
              links.
            </p>
            <button class="fk-community-cta fk-submit" type="submit">
              Send to review
            </button>
          </form>

          <div id="community-posts" class="fk-post-list" aria-live="polite">
            <p>Published field notes will appear when the community returns.</p>
          </div>
        </div>

        <aside class="fk-community-rule">
          <p class="fk-community-kicker">KEEPER’S FIELD RULE</p>
          <h3>Share when it helps your community.</h3>
          <p>
            {membershipConfig.memberDefinition}. Membership is free and never
            depends on posting. When the community opens, we welcome useful
            notes, questions, and corrections.
          </p>
          <p>
            No promotional post is required. Public guides on this site remain
            ungated; access controls for future gated materials are not active
            here yet.
          </p>
          <blockquote>“Leave a better map than the one you found.”</blockquote>
        </aside>
      </div>
    </section>

    <section class="fk-community-channels">
      <h2>Find your way in</h2>
      <p>
        Follow project updates, explore the tools we discuss, or ask about a
        nonprofit assessment. You do not need to publish anything to follow
        public channels or contact us.
      </p>
      <ForKeepsSocials />
    </section>

    <section class="fk-community-note">
      <h2>Ask questions safely</h2>
      <p>
        Share what you are trying to do, what happened, and any non-sensitive
        error messages. Remove donor records, personal information, passwords,
        API keys, and private links before posting.
      </p>
      <p>
        Public channels are for peer discussion, not guaranteed response times
        or emergency support. Use the contact page for private project
        enquiries.
      </p>
      <a href="/contact">
        Contact For Keeps <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</Layout>

<script>
  import { communityStub } from "@/lib/community.stub";

  const authNote = document.querySelector<HTMLElement>("#community-auth-note");
  const postStatus = document.querySelector<HTMLElement>(
    "#community-post-status",
  );
  const form = document.querySelector<HTMLFormElement>("#community-post-form");
  const promptSelect =
    document.querySelector<HTMLSelectElement>("#community-prompt");
  const bodyInput =
    document.querySelector<HTMLTextAreaElement>("#community-body");
  const postList = document.querySelector<HTMLElement>("#community-posts");
  const submitButton =
    form?.querySelector<HTMLButtonElement>('[type="submit"]');

  const posts = communityStub.listPosts();
  if (authNote) {
    authNote.textContent =
      "Posting is disabled while this community page is hidden.";
  }
  if (postList && posts.length === 0) {
    postList.textContent =
      "Published field notes will appear when the community returns.";
  }

  document
    .querySelectorAll<HTMLButtonElement>("[data-starter]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        if (!promptSelect || !bodyInput) return;
        promptSelect.value = button.dataset.starter || "open-note";
        bodyInput.value = button.dataset.template || "";
        bodyInput.focus();
      });
    });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!postStatus || !submitButton) return;
    communityStub.submitPost();
    submitButton.disabled = true;
    postStatus.textContent =
      "Posting is paused. Your draft was not sent or stored.";
  });
</script>

<style>
  .fk-community {
    padding-block: 1.5rem;
  }

  .fk-community-hero,
  .fk-post-intro {
    max-width: 48rem;
  }

  .fk-community-kicker {
    color: var(--color-primary);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fk-community h1,
  .fk-community h2,
  .fk-community h3 {
    font-family: var(--font-brand);
    font-weight: 400;
    line-height: 1.12;
  }

  .fk-community h1 {
    max-width: 14ch;
    margin: 0.65rem 0 0.85rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  .fk-community h2 {
    margin: 0.35rem 0 0.7rem;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
  }

  .fk-community h3 {
    font-size: 1.5rem;
  }

  .fk-community p {
    max-width: 70ch;
    line-height: 1.7;
  }

  .fk-community section {
    margin-top: 1.75rem;
  }

  .fk-community-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-primary);
    border-radius: 0.7rem;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .fk-community-cta:hover {
    background: var(--color-primary-strong);
  }

  .fk-community-cta:focus-visible,
  .fk-community a:focus-visible,
  .fk-prompt-button:focus-visible,
  .fk-post-composer :focus-visible {
    outline: 3px solid var(--color-accent-yellow);
    outline-offset: 3px;
  }

  .fk-post-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .fk-post-composer,
  .fk-community-rule,
  .fk-community-note {
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid rgba(143, 185, 255, 0.28);
    border-radius: 1rem;
    background: var(--color-bg-secondary);
  }

  .fk-community-rule {
    align-self: start;
    border-inline-start: 3px solid var(--color-accent-yellow);
    background: var(--color-bg-primary-dark);
    color: #f2f6fd;
  }

  .fk-community-rule .fk-community-kicker {
    color: var(--color-accent-yellow);
  }

  .fk-community-rule h3 {
    margin: 0.4rem 0 0.75rem;
  }

  .fk-community-rule blockquote {
    margin: 1rem 0 0;
    color: var(--color-primary-light);
    font-family: var(--font-brand);
    font-size: 1.35rem;
  }

  .fk-community-status {
    min-height: 1.5rem;
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .fk-community-status a,
  .fk-community-note a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fk-community-status.is-error {
    color: #b42318;
  }

  .fk-field-label {
    display: block;
    margin: 0.9rem 0 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .fk-post-composer select,
  .fk-post-composer textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--mission-line, rgba(143, 185, 255, 0.35));
    border-radius: 0.65rem;
    background: var(--color-bg-primary);
    color: var(--color-text-secondary);
    font: inherit;
  }

  .fk-post-composer textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .fk-prompt-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .fk-prompt-button {
    padding: 0.45rem 0.65rem;
    border: 1px solid rgba(45, 109, 195, 0.3);
    border-radius: 999px;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
  }

  .fk-safety-note {
    color: var(--color-text-tertiary);
    font-size: 0.82rem;
  }

  .fk-submit {
    margin-top: 0.35rem;
    cursor: pointer;
  }

  .fk-submit:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .fk-post-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .fk-post-card {
    padding: 1rem;
    border: 1px solid rgba(143, 185, 255, 0.2);
    border-radius: 0.75rem;
    background: var(--color-bg-primary);
  }

  .fk-post-card h3 {
    margin: 0 0 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .fk-post-card p {
    margin: 0.25rem 0 0.65rem;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .fk-post-card time {
    color: var(--color-text-tertiary);
    font-size: 0.76rem;
  }

  .fk-community-note {
    background:
      linear-gradient(135deg, rgba(250, 209, 59, 0.1), transparent 55%),
      var(--color-bg-secondary);
  }

  @media (min-width: 900px) {
    .fk-post-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
      align-items: start;
    }
  }

  :global(html.dark) .fk-post-composer,
  :global(html.dark) .fk-community-note {
    background: var(--color-bg-secondary-dark);
  }

  :global(html.dark) .fk-post-composer select,
  :global(html.dark) .fk-post-composer textarea,
  :global(html.dark) .fk-post-card {
    background: var(--color-bg-primary-dark);
    color: var(--color-text-secondary-dark);
  }

  :global(html.dark) .fk-community-status.is-error {
    color: #fda29b;
  }
</style>
