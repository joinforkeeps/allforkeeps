---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";

const features = [
  {
    icon: "/assets/icon/structure.png",
    title: "Self-Led Quickstarts",
    description:
      "Learn in practical steps at your team’s pace. Start with sample data, then decide when a tool is ready for real work.",
  },
  {
    icon: "/assets/icon/components.png",
    title: "Open-Source Stacks",
    description:
      "Compare tools for fundraising, operations, and local AI with their licensing, hosting, support, and maintenance trade-offs in view.",
  },
  {
    icon: "/assets/icon/document.png",
    title: "Clear Guides",
    description:
      "Understand what a system does, what it depends on, who must maintain it, and how to move your data if you leave.",
  },
  {
    icon: "/assets/icon/fast.png",
    title: "Zero Hidden Fees",
    description:
      "Public guides are free to read. Any paid implementation is scoped and priced before work begins; third-party and operating costs are disclosed separately.",
  },
];
---

<Layout
  title="Features"
  description="Self-led nonprofit technology quickstarts, Open Source tool comparisons, clear guides, and transparent project pricing."
>
  <main class="site-container py-6 md:py-10">
    <PageHeader
      title="Know the trade-offs. Keep the keys."
      description="For Keeps gives nonprofit teams a practical path from software guesswork to informed decisions."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6">
      {
        features.map((feature) => (
          <article class="p-6 md:p-8 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm">
            <img
              src={feature.icon}
              alt=""
              width="56"
              height="56"
              class="w-14 h-14 mb-5 object-contain"
            />
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-white mb-3">
              {feature.title}
            </h2>
            <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
              {feature.description}
            </p>
          </article>
        ))
      }
    </div>
    <div class="mt-5 flex flex-wrap gap-3 justify-center">
      <Button url="/courses" type="fill">Browse the guides</Button>
      <Button url="/pricing">See access and pricing</Button>
    </div>
  </main>
</Layout>
