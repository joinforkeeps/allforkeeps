---
import Layout from "@/layouts/Layout.astro";
import Pricing from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import PageHeader from "@/components/elements/PageHeader.astro";

const pricingFaq = [
  {
    question: "Do the free resources require a subscription?",
    answer:
      "No. Public guides on this site are free to read. The software they discuss may have separate license, infrastructure, hosting, support, or maintenance costs.",
  },
  {
    question: "What is the Join For Keeps community rule?",
    answer:
      "To maintain access to gated courses and guides, members must make at least one substantive contribution every 30 days. A tool review, project update, nonprofit technology pain point, or guide improvement qualifies. Public resources remain ungated.",
  },
  {
    question: "What does Enterprise mean?",
    answer:
      "Enterprise work is scoped per project. We agree on deliverables, responsibilities, costs, and any ongoing support before work begins. It is not a recurring subscription by default.",
  },
];
---

<Layout
  title="Pricing"
  description="Clear access rules for free nonprofit technology guides, the For Keeps community, and custom enterprise projects."
>
  <main class="py-6 md:py-8">
    <PageHeader
      title="Straight answers. No subscription trap."
      description="Read the free guides, contribute to the community, or request a project quote with a written scope."
    />
    <Pricing showHeader={false} />
    <div class="site-container mt-4">
      <FAQ title="Pricing and access" items={pricingFaq} />
    </div>
  </main>
</Layout>
