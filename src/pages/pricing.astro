---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import FAQ from "@/components/sections/FAQ.astro";
import Button from "@/components/ui/Button.astro";
import { Check } from "@lucide/astro";

const pricingFaq = [
  {
    question: "Is the Community tier really free?",
    answer:
      "Yes. All you need to do is share a post on the community page promoting a self-hosted tool you love.",
  },
  {
    question: "What does the Nonprofit Assessment include?",
    answer:
      "Complete surveyed look into the current deployment of your CRM, forms, and donor systems configured on hardware you own, plus staff training.",
  },
];
---

<Layout
  title="For Keeps: Pricing & Tiers"
  description="Self-led courses, peer learning community access, and custom nonprofit tech stack assessments."
>
  <div class="py-16 md:py-24 site-container">
    <PageHeader
      title="Transparent Pricing for Nonprofits"
      description="No SaaS subscription lock-in. Choose self-led learning or complete custom assessments."
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-12">
      <!-- Free Tier -->
      <div
        class="p-8 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm flex flex-col"
      >
        <h3 class="text-xl font-bold text-neutral-900 dark:text-white">
          Free Courses Available
        </h3>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-2">
          Straight to the courses page with zero friction.
        </p>
        <div class="my-6">
          <span class="text-4xl font-extrabold text-neutral-900 dark:text-white"
            >$0</span
          ><span class="text-neutral-500"> / forever</span>
        </div>
        <ul
          class="space-y-3 mb-8 flex-1 text-sm text-neutral-600 dark:text-neutral-300"
        >
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> General e-learning courses
          </li>
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Self-paced technical quickstarts
          </li>
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Community documentation access
          </li>
        </ul>
        <Button url="/courses" className="w-full text-center justify-center"
          >Start Learning Now</Button
        >
      </div>

      <!-- Community Tier -->
      <div
        class="p-8 rounded-2xl bg-white dark:bg-neutral-900 border-2 border-primary shadow-md flex flex-col relative"
      >
        <span
          class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-xs px-3 py-1 rounded-full font-semibold"
          >For Builders</span
        >
        <h3 class="text-xl font-bold text-neutral-900 dark:text-white">
          Community Crew
        </h3>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-2">
          Peer learning community access & early course releases.
        </p>
        <div class="my-6">
          <span class="text-4xl font-extrabold text-neutral-900 dark:text-white"
            >Free</span
          ><span class="text-neutral-500"> (with social post)</span>
        </div>
        <ul
          class="space-y-3 mb-8 flex-1 text-sm text-neutral-600 dark:text-neutral-300"
        >
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Discord, Mastodon & Telegram access
          </li>
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Early access to upcoming courses
          </li>
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Share open-source starter pack
            items
          </li>
        </ul>
        <Button url="/community" className="w-full text-center justify-center"
          >Join Community</Button
        >
      </div>

      <!-- Nonprofit Assessment Tier -->
      <div
        class="p-8 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm flex flex-col"
      >
        <h3 class="text-xl font-bold text-neutral-900 dark:text-white">
          Nonprofit Assessment
        </h3>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-2">
          Custom tools assessed for your size / needs / goals; configured to
          your current tech stack.
        </p>
        <div class="my-6">
          <span class="text-4xl font-extrabold text-neutral-900 dark:text-white"
            >Custom</span
          ><span class="text-neutral-500"> / project</span>
        </div>
        <ul
          class="space-y-3 mb-8 flex-1 text-sm text-neutral-600 dark:text-neutral-300"
        >
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Custom CRM & donor stack assessment
          </li>
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Grant & funding tool assessment
          </li>
          <li class="flex items-center gap-2">
            <Check class="w-4 h-4 text-primary" /> Full ownership guarantee & training
            documentation
          </li>
        </ul>
        <Button url="/contact" className="w-full text-center justify-center"
          >Book Assessment</Button
        >
      </div>
    </div>

    <div class="mt-20">
      <FAQ title="Pricing & Access FAQ" items={pricingFaq} />
    </div>
  </div>
</Layout>