---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
---

<Layout
  title="Assessment & Contact: For Keeps"
  description="Get in touch for custom tech stack assessments, community access, or course feedback."
>
  <div class="py-16 md:py-24 site-container">
    <PageHeader
      title="Nonprofit Technology Assessment"
      description="Tell us about your organization. Complete our intake form and we'll get back to you with a customized assessment."
    />

    <div
      class="max-w-2xl mx-auto mt-12 bg-white dark:bg-neutral-900 p-8 md:p-12 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm"
    >
      <form class="space-y-6" action="#" method="POST">
        <div>
          <label
            class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2"
            >Organization Name</label
          >
          <input
            type="text"
            required
            placeholder="e.g., Save the Children"
            class="w-full px-4 py-3 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white focus:outline-none focus:border-primary"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label
              class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2"
              >Your Name</label
            >
            <input
              type="text"
              required
              placeholder="Alan Keeps"
              class="w-full px-4 py-3 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white focus:outline-none focus:border-primary"
            />
          </div>
          <div>
            <label
              class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2"
              >Email Address</label
            >
            <input
              type="email"
              required
              placeholder="alan@allforkeeps.com"
              class="w-full px-4 py-3 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white focus:outline-none focus:border-primary"
            />
          </div>
        </div>

        <div>
          <label
            class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2"
            >What tools, nonprofit systems,or AI features are you trying to build first?</label
          >
          <textarea
            rows="4"
            placeholder="Donor CRM, volunteer scheduling, grant intake forms..."
            class="w-full px-4 py-3 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white focus:outline-none focus:border-primary"
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="w-full py-4 rounded-lg bg-primary text-white font-semibold hover:bg-primary-strong transition-colors"
          >
            Submit Assessment Intake
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>
