---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
---

<Layout
  title="Sign in"
  description="Sign in to post a field note in the For Keeps community."
>
  <main class="site-container py-8 md:py-12">
    <PageHeader
      title="Welcome back, Cadet."
      description="Sign in to add a field note to the community board. Public guides stay open to everyone."
    />
    <div class="mx-auto max-w-xl rounded-2xl border border-primary/20 bg-white p-6 dark:bg-[#0f1b2d] md:p-8">
      <form id="sign-in-form" class="space-y-5">
        <label class="block text-sm font-medium" for="email">
          Email address
          <input id="email" name="email" type="email" autocomplete="email" required
            class="mt-2 w-full rounded-lg border border-neutral-300 bg-transparent px-4 py-3 dark:border-neutral-700" />
        </label>
        <label class="block text-sm font-medium" for="password">
          Password
          <input id="password" name="password" type="password" autocomplete="current-password" required
            class="mt-2 w-full rounded-lg border border-neutral-300 bg-transparent px-4 py-3 dark:border-neutral-700" />
        </label>
        <button id="sign-in-submit" type="submit"
          class="w-full rounded-lg bg-primary px-5 py-3 font-semibold text-white transition-colors hover:bg-primary-strong disabled:cursor-not-allowed disabled:opacity-60">
          Sign in to post
        </button>
        <p id="sign-in-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
      <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-300">
        New to the crew? <a class="font-semibold text-primary underline" href="/sign-up?next=/community">Create an account</a>.
      </p>
    </div>
  </main>
</Layout>

<script>
  import { getLocalRedirectTarget, getSupabaseClient } from "@/lib/supabase";

  const form = document.querySelector<HTMLFormElement>("#sign-in-form");
  const status = document.querySelector<HTMLElement>("#sign-in-status");
  const submit = document.querySelector<HTMLButtonElement>("#sign-in-submit");
  const supabase = getSupabaseClient();

  if (!supabase && status && submit) {
    status.textContent =
      "Community accounts are not available yet. The dedicated For Keeps Supabase settings still need to be configured.";
    status.className = "text-sm text-amber-700 dark:text-amber-300";
    submit.disabled = true;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status || !submit) return;
    if (!supabase) {
      status.textContent = "Sign-in is unavailable until account services are configured.";
      return;
    }

    const data = new FormData(form);
    const email = String(data.get("email") || "").trim();
    const password = String(data.get("password") || "");
    submit.disabled = true;
    status.textContent = "Checking your key...";
    status.className = "text-sm text-neutral-600 dark:text-neutral-300";

    try {
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        status.textContent = error.message;
        status.className = "text-sm text-red-700 dark:text-red-300";
        return;
      }

      const next = getLocalRedirectTarget(
        new URLSearchParams(window.location.search).get("next"),
      );
      window.location.assign(next);
    } catch (error) {
      console.error("Community sign-in failed", error);
      status.textContent = "We could not reach the account service. Try again later.";
      status.className = "text-sm text-red-700 dark:text-red-300";
    } finally {
      submit.disabled = false;
    }
  });
</script>
