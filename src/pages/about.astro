---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import LearnTag from "@/components/content/LearnTag.astro";
import ForKeepsSocials from "@/components/sections/ForKeepsSocials.astro";
import SupportNote from "@/components/content/SupportNote.astro";
import { membershipConfig } from "@/config/membership";
import { serviceLinks, siteConfig } from "@/config/site.js";
---

<Layout
  title="About"
  description="For Keeps helps nonprofit teams make informed choices about open-source tools, self-hosting, and technology they can maintain."
>
  <main class="site-container py-6 md:py-10">
    <LearnTag />
    <PageHeader
      title="About For Keeps"
      description="For Keeps helps nonprofit teams understand their options before another contract, platform, or renewal becomes impossible to leave."
    />

    <div class="max-w-3xl mx-auto mt-6 space-y-5">
      <section>
        <h2 class="text-2xl font-brand mb-3">Learn it</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
          {siteConfig.teamClaim} We publish practical guides to open-source
          software, self-hosting, data ownership, and nonprofit technology
          costs. When an organisation needs hands on support, we discuss a
          separate project scope and price before any paid work begins.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-brand mb-3">Build it</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
          {membershipConfig.memberDefinition}. Membership is free, does not auto
          sign anyone up for a class, and we'll never require a paid
          subscription. Members get {membershipConfig.earlyAccessDays} days of
          early access to new courses and one eligible previous course free,
          with each release.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-brand mb-3">For Keeps</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
          Building your own applications is not a magic way to make software
          free. Your team still needs a plan for hosting, updates, backups,
          security, access, and recovery. Our job is to make those needs visible
          so you can choose the trade offs with full transparency.
        </p>
      </section>
      <section class="rounded-2xl border border-primary/15 bg-primary/5 p-6 md:p-8">
        <h2 class="text-2xl font-brand mb-3">Operating Locations</h2>
        <ul class="space-y-3 text-neutral-700 dark:text-neutral-200">
          <li>United States (USA)</li>
          <li>Mexico City, Mexico (CDMX)</li>
          <li>Montreal, Quebec, Canada (QC)</li>
          <li>London, England, United Kingdom (UK)</li>
        </ul>
      </section>
      <section class="rounded-2xl border border-logo-green/25 bg-logo-green/5 p-6 md:p-8">
        <h2 class="text-2xl font-brand mb-3">Community is coming</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
          We want a place for nonprofit teams and learners to share useful field
          notes, questions, and corrections. Community pages are paused for now;
          no accounts or posts are collected. Public guides stay open to
          everyone.
        </p>
      </section>
      <div class="flex flex-wrap gap-3">
        <Button url={serviceLinks.learning} type="fill" event="browseCourses">
          Browse Courses
        </Button>
        <Button url="/assessment" event="aboutAssessment">
          Book an Assessment
        </Button>
      </div>
      <section aria-labelledby="about-socials-title">
        <h2 id="about-socials-title" class="font-brand text-2xl">
          Find us around the web
        </h2>
        <ForKeepsSocials />
      </section>
      <SupportNote />
    </div>
  </main>
</Layout>
