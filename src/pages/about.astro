---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
---

<Layout
  title="About"
  description="For Keeps helps nonprofit teams make informed choices about Open Source tools, self-hosting, and technology they can maintain."
>
  <main class="site-container py-6 md:py-10">
    <PageHeader
      title="Technology should belong to the people who depend on it."
      description="For Keeps helps nonprofit teams understand their options before another contract, platform, or renewal becomes impossible to leave."
    />

    <div class="max-w-3xl mx-auto mt-6 space-y-5">
      <section>
        <h2 class="text-2xl font-brand mb-3">What we do</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
          We publish practical guides to Open Source software, self-hosting,
          data ownership, and nonprofit technology costs. When an organization
          needs hands-on support, we discuss a separate project scope and price
          before any paid work begins.
        </p>
      </section>
      <section>
        <h2 class="text-2xl font-brand mb-3">What ownership actually asks of you</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
          Owning your stack is not a magic way to make software free. Your team
          still needs a plan for hosting, updates, backups, security, access,
          and recovery. Our job is to make those obligations visible so you can
          choose the trade-offs with your eyes open.
        </p>
      </section>
      <section class="rounded-2xl border border-primary/15 bg-primary/5 p-6 md:p-8">
        <h2 class="text-2xl font-brand mb-3">The line we hold</h2>
        <ul class="space-y-3 text-neutral-700 dark:text-neutral-200">
          <li>Explain costs before commitment.</li>
          <li>Use sample data while learning.</li>
          <li>Document how to maintain a system and how to leave it.</li>
          <li>Never pretend that Open Source means effort-free.</li>
        </ul>
      </section>
      <div class="flex flex-wrap gap-3">
        <Button url="/courses" type="fill">Explore the guides</Button>
        <Button url="/contact">Request an assessment</Button>
      </div>
    </div>
  </main>
</Layout>
