---
import Layout from "@/layouts/Layout.astro";
import ForKeepsSocials from "@/components/sections/ForKeepsSocials.astro";
const areas = [
 ["Learn it", "Start with practical guides, small exercises, and repeatable checklists. Build confidence before adding complexity.", "/courses", "Explore quickstarts"],
 ["Build it", "Plan a stack around your organization’s needs: contacts, forms, volunteer workflows, backups, and documentation.", "/contact", "Discuss a project"],
 ["Keep it", "Make ownership practical with recovery plans, clear handover notes, account access, and maintenance responsibilities.", "/blog", "Read the guides"],
];
const checklist=["Define the operational problem and who will use the tool.","Identify data sensitivity and access requirements.","Budget for hosting, maintenance, training, and recovery—not just software.","Document setup, ownership, and the handover process.","Test a backup restoration before depending on the system."];
---
<Layout title="Project Toolkit | For Keeps" description="Explore the For Keeps approach to learning, open-source tools, project planning, and community.">
 <main class="site-container fk-toolkit">
  <header><p class="text-primary">THE FOR KEEPS TOOLKIT</p><h1>Learn it. Build it. Keep it.</h1><p>A practical starting point for nonprofit teams exploring open-source tools, self-hosting, and technology they can maintain.</p></header>
  <section aria-labelledby="approach"><h2 id="approach">The building blocks</h2><div class="fk-tool-grid">{areas.map(([title,desc,url,label])=><article><h3>{title}</h3><p>{desc}</p><a href={url}>{label} →</a></article>)}</div></section>
  <section aria-labelledby="planning"><h2 id="planning">Before you choose a tool</h2><p>A useful stack starts with a clear plan—not a long list of apps.</p><ol>{checklist.map(item=><li>{item}</li>)}</ol></section>
  <section aria-labelledby="funding"><h2 id="funding">Build a funding-ready project brief</h2><p>Describe your organization’s need, the people it serves, the intended outcome, the implementation timeline, and the full operating budget. Keep software, hosting, training, and ongoing support as separate cost lines.</p><p>This is a planning checklist, not a list of available grants or a promise of eligibility. Review the current criteria of any funder before applying.</p><a href="/contact">Discuss your project scope →</a></section>
  <section aria-labelledby="socials"><h2 id="socials">Find For Keeps around the web</h2><p>Explore our profiles and request access details where a public community link is still needed.</p><ForKeepsSocials /></section>
 </main>
</Layout>
<style>
.fk-toolkit{padding-top:3rem;padding-bottom:3rem}.fk-toolkit header{max-width:48rem}.fk-toolkit h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1.15;margin:1rem 0}.fk-toolkit h2{font-size:1.8rem;margin-bottom:1rem}.fk-toolkit h3{font-size:1.2rem;font-weight:600}.fk-toolkit p{line-height:1.8;margin:.75rem 0 1.25rem}.fk-toolkit section{padding-top:2.5rem}.fk-tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1rem}.fk-tool-grid article{border:1px solid #b7caff66;border-radius:1rem;padding:1.5rem}.fk-toolkit a{color:#2d6dc3;text-decoration:underline}.fk-toolkit ol{list-style:decimal;padding-left:1.5rem;line-height:1.8}.fk-toolkit li{padding:.3rem 0}:global(html.dark) .fk-toolkit a{color:#93c5fd}
</style>
