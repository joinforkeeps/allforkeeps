---
import Meta from "./Meta.astro";
import TopBg from "@/components/ui/TopBg.astro";
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import TrackGa from "@/components/widgets/TrackGa.astro";
import ComingSoon from "@/components/elements/ComingSoon.astro";
import { isPageVisible } from "@/config/pages.js";
interface Props {
  title?: string | undefined;
  description?: string | undefined;
  keywords?: string | undefined;
  lang?: string | undefined;
}
const { title, description, keywords, lang = "en-GB" } = Astro.props;
const pageVisible = isPageVisible(Astro.url.pathname);
import "../styles/global.css";
import "aos/dist/aos.css";
import "../styles/aos-custom.css";
import "../styles/article.css";
import "../styles/article-enhancements.css";
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <Meta title={title} description={description} keywords={keywords} noindex={!pageVisible} />
    <TrackGa />
    <script is:inline>
      (() => {
        let isDark = false;

        try {
          isDark = localStorage.getItem("dark_mode") === "true";
        } catch {
          isDark = document.documentElement.classList.contains("dark");
        }

        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body
    class="antialiased bg-bg-primary dark:bg-bg-primary-dark max-w-full overflow-x-hidden min-h-screen flex flex-col justify-between"
  >
<div class="relative isolate">
  <TopBg />
  <Header />
  {pageVisible ? <slot /> : <ComingSoon title={title || "This page is taking a breather."} />}
</div>
    <Footer />
    <script src="../assets/js/main.js"></script>
    <script>
      import { inView } from "motion";

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      if (!reducedMotion.matches) {
        document.querySelectorAll<HTMLElement>(".animated-text").forEach((text) => {
          inView(text, (element) => {
            element.classList.add("is-animated");
          });
        });
      }
    </script>
  </body>
</html>
